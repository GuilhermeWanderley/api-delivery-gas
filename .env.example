# =============================================================================
# Binho do Gás — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NÃO vai para o Git (está no .gitignore).
# =============================================================================

# ---------- Banco de dados ----------
DB_NAME=gasdelivery
DB_USER=gas
DB_PASSWORD=troque-esta-senha-do-banco

# ---------- Evolution API (WhatsApp) ----------
# Mesma chave do AUTHENTICATION_API_KEY do docker-compose da Evolution API.
EVOLUTION_API_KEY=change-me
# Timeouts e retry da integração
EVOLUTION_TIMEOUT_CONEXAO_MS=3000
EVOLUTION_TIMEOUT_LEITURA_MS=8000
EVOLUTION_MAX_TENTATIVAS=3
EVOLUTION_ESPERA_BASE_MS=700

# ---------- Segurança do painel ----------
# AMBIENTE: use "producao" no servidor. Nesse modo a aplicação se RECUSA a
# subir se a senha for a padrão/curta, se o BOT_API_KEY estiver vazio ou se o
# CORS apontar só para localhost. Na sua máquina deixe "desenvolvimento".
APP_AMBIENTE=desenvolvimento

# Login usado no painel. TROQUE a senha antes de publicar (mín. 12 caracteres).
APP_ADMIN_USUARIO=admin
APP_ADMIN_SENHA=troque-esta-senha

# Chave que o Typebot precisa enviar no header "X-Api-Key" ao criar pedidos.
# Deixar VAZIO abre o endpoint do robô (só use assim em desenvolvimento local).
# Gere uma chave forte, por exemplo:  openssl rand -hex 32
BOT_API_KEY=

# Origens liberadas no CORS, separadas por vírgula.
# Em produção, use o domínio real do painel (ex.: https://painel.binhodogas.com.br)
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
